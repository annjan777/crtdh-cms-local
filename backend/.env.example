# Local development only. Copy to backend/.env (gitignored). Production values live in deploy/.env.
# With DEBUG=True and no SECRET_KEY, a random key is generated per process.
DEBUG=True
CRTDH_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
# Let the admin dev server (Vite) call the API with the session cookie.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_URLS_REGEX=^/api/.*$
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174
# Optional: the Django admin (bypasses MFA; refused in production).
# DJANGO_ADMIN_ENABLED=True
