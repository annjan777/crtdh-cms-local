# Copy to .env and fill in real values for your environment.
# None of these are read from source control — django-environ loads this file.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres, matching the docker-compose `db` service by default.
# For local dev without postgres running, override with e.g.:
#   DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL=postgres://crtdh:crtdh@db:5432/crtdh

# Comma-separated list of origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
