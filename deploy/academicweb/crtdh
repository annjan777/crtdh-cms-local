#!/usr/bin/env bash
# CRTDH website on academicweb: one command for everything after setup.
#
#   ~/.crtdh/crtdh status          is everything running? what is live?
#   ~/.crtdh/crtdh start | stop | restart
#   ~/.crtdh/crtdh update          newest code from GitHub, restart (content is kept)
#   ~/.crtdh/crtdh go-live         publish the CMS content and make it the live site
#   ~/.crtdh/crtdh old-site        put the old hand-written site back (the CMS keeps running)
#   ~/.crtdh/crtdh new-site        back to the newest CMS release
#   ~/.crtdh/crtdh access campus   the CMS opens only from the campus network (default)
#   ~/.crtdh/crtdh access anywhere the CMS login page opens from anywhere
#   ~/.crtdh/crtdh add-user        create another CMS admin (asks for the details)
#   ~/.crtdh/crtdh users           every CMS user with their role (editor, publisher, admin)
#   ~/.crtdh/crtdh make-admin <username>   give that user the admin role
#   ~/.crtdh/crtdh import <address> replace the CMS content, photos and users with a staging export, then publish
#   ~/.crtdh/crtdh logs [web|worker|agent]
#
# Cron runs "watchdog" every 5 minutes and at reboot (starts what stopped, rebuilds a wiped programs folder)
# and "nightly" at 03:23 (data backup into ~/.crtdh/backups, keeps the programs folder from being cleaned up).
set -uo pipefail

KEEP="${CRTDH_KEEP:-$HOME/.crtdh}"
ROOT="${CRTDH_INSTALL:-$(cat "$KEEP/install-dir" 2>/dev/null)}"
APP="$ROOT/app"
WEB_ROOT="$HOME"
SITE="https://crtdh.iitkgp.ac.in"
[ -f "$KEEP/env" ] && { s="$(sed -n 's/^SITE_URL=//p' "$KEEP/env")"; [ -n "$s" ] && SITE="$s"; }
CMS="$SITE/cms/index.php"

say() { printf '%s\n' "$*"; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

load_env() {
  [ -f "$KEEP/env" ] || die "$KEEP/env is missing. Run the installer first."
  [ -f "$ROOT/paths.env" ] || die "the programs folder is missing. Run: bash ~/.crtdh/install.sh --repair"
  set -a; . "$KEEP/env"; . "$ROOT/paths.env"; set +a
  PORT="${CRTDH_PORT:-8650}"
  export PATH="$ROOT/node/bin:$ROOT/venv/bin:$PATH" HOME
  ulimit -n "$(ulimit -Hn)" 2>/dev/null || ulimit -n 65536 2>/dev/null || true
}

manage() { (cd "$APP/backend" && "$ROOT/venv/bin/python" manage.py "$@"); }
agent() { (cd "$APP" && "$ROOT/venv/bin/python" -m publish_agent -c "$ROOT/agent/config.ini" "$@"); }

# ---- processes ------------------------------------------------------------------------------------------
cmd_for() {
  case "$1" in
    web) echo "cd '$APP/backend' && exec '$ROOT/venv/bin/python' -m gunicorn config.wsgi:application \
--bind 127.0.0.1:$PORT --workers 3 --timeout 330 --access-logfile - --error-logfile - --capture-output" ;;
    worker) echo "cd '$APP/backend' && exec '$ROOT/venv/bin/python' manage.py run_publish_worker" ;;
    agent) echo "cd '$APP' && exec '$ROOT/venv/bin/python' -m publish_agent -c '$ROOT/agent/config.ini' run" ;;
  esac
}
SERVICES="web worker agent"

# Alive = the recorded process exists AND is ours (after a reboot an old number can belong to anything).
alive() {
  local f="$ROOT/run/$1.pid" pid
  [ -f "$f" ] || return 1
  pid="$(cat "$f")"
  kill -0 "$pid" 2>/dev/null && ps -p "$pid" -o args= 2>/dev/null | grep -qF "$ROOT"
}

start_one() {
  alive "$1" && return 0
  mkdir -p "$ROOT/run" "$ROOT/logs"
  setsid nohup bash -c "$(cmd_for "$1")" >>"$ROOT/logs/$1.log" 2>&1 < /dev/null &
  echo $! > "$ROOT/run/$1.pid"
}

stop_one() {
  local f="$ROOT/run/$1.pid"
  if alive "$1"; then
    local pid; pid="$(cat "$f")"
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
    for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
    kill -KILL -- "-$pid" 2>/dev/null || true
  fi
  rm -f "$f"
}

cms_answers() { curl -s -o /dev/null -m 3 "http://127.0.0.1:$PORT/api/v1/auth/csrf/"; }

do_start() {
  load_env
  for s in $SERVICES; do start_one "$s"; done
  for _ in $(seq 1 40); do cms_answers && return 0; sleep 1; done
  say "The CMS did not answer on port $PORT. See: ~/.crtdh/crtdh logs web"
  return 1
}

# "mcp" is the Claude connector of older installs: stopped here so an update leaves nothing of it running.
do_stop() { [ -n "$ROOT" ] && for s in $SERVICES mcp; do stop_one "$s"; done; }

rotate_logs() {
  for f in "$ROOT"/logs/*.log; do
    [ -f "$f" ] || continue
    [ "$(stat -c %s "$f" 2>/dev/null || echo 0)" -gt 20000000 ] && mv -f "$f" "$f.1"
  done
}

# The programs folder can be cleaned away by the system (it is on /var/tmp); rebuild it, at most once an hour.
repair_if_missing() {
  [ -d "$APP/backend" ] && [ -x "$ROOT/venv/bin/python" ] && [ -f "$ROOT/paths.env" ] && return 0
  local stamp="$KEEP/.last-repair"
  [ -f "$stamp" ] && [ $(( $(date +%s) - $(stat -c %Y "$stamp") )) -lt 3600 ] && return 1
  touch "$stamp"
  printf '%s programs folder missing: rebuilding\n' "$(date -Is)" >> "$KEEP/repair.log"
  bash "$KEEP/install.sh" --repair >> "$KEEP/repair.log" 2>&1 < /dev/null
}

# Data backup (one file on the persistent drive, 7 kept) + keep the programs folder "recently used".
do_nightly() {
  load_env
  find "$ROOT" -xdev -exec touch -h -c -a {} + 2>/dev/null || true
  local tmp; tmp="$(mktemp -d "$ROOT/.snap.XXXXXX")"
  "$ROOT/venv/bin/python" - "$ROOT/data/cms.sqlite3" "$tmp/cms.sqlite3" <<'PYEOF'
import sqlite3, sys
src, dst = sqlite3.connect(sys.argv[1]), sqlite3.connect(sys.argv[2])
src.backup(dst)
dst.close(); src.close()
PYEOF
  local out="$KEEP/backups/data-$(date +%Y%m%d).tar.gz"
  tar -czf "$out.part" -C "$tmp" cms.sqlite3 -C "$ROOT/data" media && mv -f "$out.part" "$out" && chmod 600 "$out"
  rm -rf "$tmp"
  ls -1t "$KEEP"/backups/data-*.tar.gz 2>/dev/null | tail -n +8 | xargs -r rm -f
  manage purge_contact_messages; manage clearsessions; manage clear_auth_throttles
  rotate_logs
  say "$(date -Is) nightly: $(basename "$out") ($(du -h "$out" | cut -f1))"
}

# ---- publishing ---------------------------------------------------------------------------------------------
do_publish() {
  load_env
  { alive worker && alive agent; } || do_start || return 1
  local out id status=""
  out="$(manage shell -c '
from django.contrib.auth import get_user_model
from apps.publishing.publish import start_publish
u = get_user_model().objects.filter(is_superuser=True, is_active=True).order_by("date_joined").first()
p = start_publish(u, confirm_shrink=True)
print("PUBLISH", p.id)' 2>&1)" || { say "$out"; return 1; }
  id="$(printf '%s\n' "$out" | sed -n 's/^PUBLISH //p' | tail -1)"
  [ -n "$id" ] || { say "$out"; return 1; }
  say "Publishing (this takes 1-3 minutes)..."
  for _ in $(seq 1 120); do
    status="$(manage shell -c "
from apps.publishing.models import Publish
p = Publish.objects.get(pk='$id'); print('STATE', p.status, '|', p.message.replace(chr(10), ' ')[:300])" 2>/dev/null | sed -n 's/^STATE //p')"
    case "$status" in
      live*) say "  live."; rm -f "$KEEP/old-site-live"; return 0 ;;
      failed*|cancelled*) say "  $status"; say "Details: ~/.crtdh/crtdh logs worker  and  ~/.crtdh/crtdh logs agent"; return 1 ;;
    esac
    sleep 5
  done
  say "  still not live after 10 minutes: $status"; return 1
}

check_live() {
  local fail=0 got c="curl -s -m 20 ${CRTDH_CURL_RESOLVE:-}"
  got="$($c "$SITE/" | grep -c 'name="crtdh-build"')"
  [ "$got" -ge 1 ] && say "  ok   home page is the new site" || { say "  FAIL home page is not the new site"; fail=1; }
  $c "$SITE/about.html" | grep -q 'url=/about/' && say "  ok   old address /about.html forwards to /about/" \
    || { say "  FAIL /about.html does not forward"; fail=1; }
  got="$($c -o /dev/null -w '%{http_code}' "$SITE/.crtdh/env")"
  case "$got" in 403|404) say "  ok   settings are not reachable from the web ($got)" ;; *) say "  FAIL /.crtdh/env answered $got"; fail=1 ;; esac
  got="$($c -o /dev/null -w '%{http_code}' "$CMS/")"
  say "  ok   CMS answers at $SITE/cms/ ($got; 403 = this server is not on the campus list, your PC is)"
  return $fail
}

# current | newest, from the agent's own record
release_of() {
  agent status 2>/dev/null | "$ROOT/venv/bin/python" -c '
import json, sys
try:
    srv = json.load(sys.stdin)["server"]
except Exception:
    sys.exit(0)
hist = [h for h in (srv.get("history") or []) if not h.startswith("legacy-")]
print((srv.get("current") or "") if sys.argv[1] == "current" else (hist[-1] if hist else ""))' "$1"
}

set_access() {
  sed -i "s/^\$ACCESS = '[a-z]*';/\$ACCESS = '$1';/" "$WEB_ROOT/cms/index.php" || return 1
  sed -i '/^access=/d' "$KEEP/host.conf" 2>/dev/null; printf 'access=%s\n' "$1" >> "$KEEP/host.conf"
}

# ---- commands -------------------------------------------------------------------------------------------------
case "${1:-status}" in
  start) do_start && say "CMS running: $SITE/cms/" ;;
  stop) do_stop; say "stopped (the public site stays up; only editing stops)" ;;
  restart) do_stop; do_start && say "restarted" ;;
  watchdog) repair_if_missing && [ -f "$KEEP/env" ] && do_start >/dev/null 2>&1 ;;
  nightly) do_nightly ;;
  status)
    load_env
    for s in $SERVICES; do alive "$s" && say "  $s: running" || say "  $s: STOPPED"; done
    cms_answers && say "  CMS answers on 127.0.0.1:$PORT" || say "  CMS does not answer (run: ~/.crtdh/crtdh start)"
    [ -f "$KEEP/old-site-live" ] && say "  live now: the OLD site" || say "  live now: release $(release_of current)"
    say "  CMS access: $(sed -n 's/^access=//p' "$KEEP/host.conf" 2>/dev/null)"
    say "  last data backup: $(ls -1t "$KEEP"/backups/data-*.tar.gz 2>/dev/null | head -1 | xargs -r basename)" ;;
  logs) tail -n 80 "$ROOT/logs/${2:-web}.log" ;;
  access)
    case "${2:-}" in campus|anywhere) ;; *) die "use: crtdh access campus | crtdh access anywhere" ;; esac
    set_access "$2" && say "CMS access: $2" ;;
  go-live) do_publish && { say "Checking the live site:"; check_live; } ;;
  old-site)
    load_env
    B="$(ls -1 "$KEEP"/backups/old-site-*.tar.gz 2>/dev/null | head -1)"; [ -n "$B" ] || die "no saved copy of the old site"
    stop_one agent
    tar -xzf "$B" -C "$WEB_ROOT" && touch "$KEEP/old-site-live" && say "The old site is live again (from $(basename "$B")). The CMS keeps running at $SITE/cms/"
    start_one agent ;;
  new-site)
    load_env
    rel="$(release_of newest)"; [ -n "$rel" ] || die "no CMS release yet; run: ~/.crtdh/crtdh go-live"
    stop_one agent; agent rollback --to "$rel" --again; rc=$?; start_one agent
    [ $rc = 0 ] && rm -f "$KEEP/old-site-live" && say "Release $rel is live." ;;
  add-user) load_env; manage createsuperuser ;;
  users) load_env; manage cms_users ;;
  make-admin)
    load_env; [ -n "${2:-}" ] || die "use: ~/.crtdh/crtdh make-admin <username>   (see: ~/.crtdh/crtdh users)"
    manage cms_users --make-admin "$2" ;;
  import)
    load_env; SRC="${2:-}"; [ -n "$SRC" ] || die "use: ~/.crtdh/crtdh import <address printed by the homelab export>"
    [ -f "$APP/deploy/transfer.py" ] || die "this install is too old for import; run: ~/.crtdh/crtdh update"
    do_nightly >/dev/null || die "the safety backup of the current data failed; nothing was changed"
    PRE="$KEEP/backups/pre-import-$(date +%Y%m%d-%H%M%S).tar.gz"
    cp "$(ls -1t "$KEEP"/backups/data-*.tar.gz | head -1)" "$PRE" && chmod 600 "$PRE"
    say "Saved the current CMS data in $PRE"
    do_stop
    (cd "$APP/backend" && "$ROOT/venv/bin/python" ../deploy/transfer.py import "$SRC"); rc=$?
    do_start || exit 1
    [ $rc = 0 ] || exit $rc
    do_publish && { say "Checking the live site:"; check_live; }
    say "To undo: ~/.crtdh/crtdh stop; tar -xzf $PRE -C $ROOT/data; ~/.crtdh/crtdh start; ~/.crtdh/crtdh go-live" ;;
  update) exec bash "$KEEP/install.sh" --update ;;
  *) sed -n '2,18p' "$0" ;;
esac
