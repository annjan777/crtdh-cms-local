# Copy to deploy/.env and fill in real values before running `docker compose up`.
# This single file supplies: Postgres credentials, Django settings, and the
# build-time API URLs baked into the two static frontends.

# --- Domains -----------------------------------------------------------
# The public site and the admin SPA are served on two separate (sub)domains
# so the admin build can be a plain static SPA with no path-prefix routing
# headaches, and so it's trivial to lock the admin domain down further later
# (e.g. IP allowlist at the nginx layer) without touching the public site.
PUBLIC_DOMAIN=crtdh.example.com
ADMIN_DOMAIN=admin.crtdh.example.com

# Used for Let's Encrypt registration (certbot) and nginx `server_name`.
CERTBOT_EMAIL=admin@example.com

# --- Postgres ------------------------------------------------------------
POSTGRES_DB=crtdh
POSTGRES_USER=crtdh
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- Django backend --------------------------------------------------------
# NOTE: docker-compose .env files do NOT reliably expand ${OTHER_VAR}
# references to each other across all Compose versions, so every value
# below is spelled out fully rather than chained — when you change
# PUBLIC_DOMAIN/ADMIN_DOMAIN above, update these four lines to match.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
# Backend is only reached through the nginx proxy on these host headers.
DJANGO_ALLOWED_HOSTS=crtdh.example.com,admin.crtdh.example.com
# Must match the two frontend origins exactly (scheme + host, no trailing slash).
CORS_ALLOWED_ORIGINS=https://crtdh.example.com,https://admin.crtdh.example.com
# Composed for docker-compose's `db` service; rarely needs changing beyond
# keeping user/password in sync with POSTGRES_USER/POSTGRES_PASSWORD above.
DATABASE_URL=postgres://crtdh:change-me-to-a-strong-password@db:5432/crtdh

# --- Frontend / admin build args -------------------------------------------
# Vite inlines these at BUILD time, not container start — changing them
# requires `docker compose build frontend admin` again, not just a restart.
PUBLIC_API_BASE_URL=https://crtdh.example.com/api/v1
ADMIN_API_BASE_URL=https://crtdh.example.com/api/v1
