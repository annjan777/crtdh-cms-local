# Copy to deploy/.env (gitignored) and fill every <...> value. Never commit the real file.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Hostnames ----------------------------------------------------------------
CMS_HOST=<cms.example.org>
CONTACT_HOST=<contact.example.org>
PUBLIC_SITE_URL=<https://crtdh.example.org>

# --- Postgres -------------------------------------------------------------------
POSTGRES_DB=crtdh
POSTGRES_USER=crtdh
POSTGRES_PASSWORD=<random 32+ chars>

# --- Django (read by cms, mcp, worker, housekeeping, migrate) --------------------
SECRET_KEY=<random 64 chars>
ALLOWED_HOSTS=<cms.example.org,contact.example.org,mcp.example.org>
CSRF_TRUSTED_ORIGINS=<https://cms.example.org>
# Only the public static site may call the contact endpoint cross-origin.
CORS_ALLOWED_ORIGINS=<https://crtdh.example.org>
DATABASE_URL=<postgres://crtdh:PASSWORD@db:5432/crtdh>

# Contact relay
TURNSTILE_SECRET=<from the Cloudflare Turnstile widget>
CONTACT_NOTIFY_EMAIL=<enquiries@example.org>
CONTACT_RETENTION_DAYS=365
DEFAULT_FROM_EMAIL=<CRTDH website <no-reply@example.org>>
EMAIL_URL=<smtp+tls://user:password@smtp.example.org:587>

# MCP (mcp lane)
MCP_PUBLIC_URL=<https://mcp.example.org>
CMS_PUBLIC_URL=<https://cms.example.org>

# --- Cloudflare tunnel ------------------------------------------------------------
CLOUDFLARED_IMAGE=<cloudflare/cloudflared:VERSION@sha256:DIGEST>
