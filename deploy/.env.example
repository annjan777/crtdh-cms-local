# Copy to deploy/.env (gitignored) and fill every <...> value. Never commit the real file.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Every environment variable the code reads is listed here. Lines starting with "# NAME="
# are optional: the value shown is the built-in default. A section at the end lists the
# variables set by docker-compose.yml (do not set them here) and the ones for tests and
# local development only (never set them in production).

# --- Hostnames (docker-compose.yml, gateway) ----------------------------------------
CMS_HOST=<cms.example.org>
CONTACT_HOST=<contact.example.org>
PUBLIC_SITE_URL=<https://crtdh.example.org>

# --- Postgres -------------------------------------------------------------------
POSTGRES_DB=crtdh
POSTGRES_USER=crtdh
POSTGRES_PASSWORD=<random 32+ chars>

# --- Django (read by cms, mcp, worker, housekeeping, migrate) --------------------
SECRET_KEY=<random 64 chars>
ALLOWED_HOSTS=<cms.example.org,contact.example.org,mcp.example.org>
CSRF_TRUSTED_ORIGINS=<https://cms.example.org>
DATABASE_URL=<postgres://crtdh:PASSWORD@db:5432/crtdh>
# DB_CONN_MAX_AGE=60
# SECURE_SSL_REDIRECT=False            # TLS ends at Cloudflare; the tunnel speaks HTTP inside
# SESSION_COOKIE_AGE=28800             # seconds (8 h)
# DJANGO_ADMIN_ENABLED=False           # refused in production (bypasses MFA)
# DJANGO_ADMIN_READONLY=True           # default: True unless DEBUG
# CONTENT_SECURITY_POLICY=<default in config/settings.py; widen only with care>

# CORS: only the public static site may call the contact endpoint cross-origin.
CORS_ALLOWED_ORIGINS=<https://crtdh.example.org>
# CORS_URLS_REGEX=^/api/v1/contact/$
# CORS_ALLOW_CREDENTIALS=False
# CORS_ALLOW_ALL_ORIGINS=False         # refused in production

# --- Sign-in and MFA --------------------------------------------------------------
# MFA_ENABLED=False                    # two-step sign-in (authenticator app). Off: password only
# MFA_ISSUER=CRTDH CMS                 # name shown in authenticator apps (MFA_ENABLED=True only)
# CMS_LOGIN_URL=/cms/login
# AUTH_THROTTLE_RATE=20/min
# AUTH_LOCKOUT_USER_THRESHOLD=5
# AUTH_LOCKOUT_IP_THRESHOLD=20

# --- Contact relay ----------------------------------------------------------------
TURNSTILE_SECRET=<from the Cloudflare Turnstile widget>
CONTACT_NOTIFY_EMAIL=<enquiries@example.org>
CONTACT_RETENTION_DAYS=365
# CONTACT_THROTTLE_RATE=5/min
DEFAULT_FROM_EMAIL=<CRTDH website <no-reply@example.org>>
EMAIL_URL=<smtp+tls://user:password@smtp.example.org:587>

# --- Uploads ----------------------------------------------------------------------
# UPLOAD_MAX_IMAGE_BYTES=15728640      # 15 MB
# UPLOAD_MAX_DOCUMENT_BYTES=20971520   # 20 MB
# UPLOAD_MAX_VIDEO_BYTES=209715200     # 200 MB
# UPLOAD_LINK_TTL_MINUTES=30           # one-time photo upload links

# --- Publishing (worker: snapshot, frontend build, tarball for the publish agent) --
CMS_PUBLIC_URL=<https://cms.example.org>
# Shared with the publish agent on the campus PC (its agent-secret.txt, next to config.ini); HMAC-SHA256 of every agent request.
AGENT_HMAC_SECRET=<random 64 chars, same value as the publish agent's>
# AGENT_MAX_SKEW=300                   # seconds of clock difference allowed on agent requests
# PUBLISH_STALE_UPLOAD_AFTER=1800     # seconds an "uploading" publish may go without an agent report before it fails
# Same-host callers that send X-CMS-Internal with this value may set X-CMS-Channel. Empty = never.
CMS_INTERNAL_SECRET=<random 64 chars, or empty to disable>
# PUBLISH_ROOT, FRONTEND_BUILD_CMD and FRONTEND_BUILD_OUTPUT are fixed by docker-compose.yml / the worker image
# (deploy/worker/Dockerfile): the worker runs the site build with SNAPSHOT_PATH and BUILD_OUTPUT_DIR set per publish.
# FRONTEND_BUILD_TIMEOUT=900           # seconds

# Read by the frontend build (frontend/scripts/postbuild.mjs, ContactForm) inside FRONTEND_BUILD_CMD.
SITE_URL=<https://crtdh.example.org>
CONTACT_API_URL=<https://contact.example.org/api/v1/contact/>
TURNSTILE_SITE_KEY=<public site key of the same Turnstile widget>

# --- Claude connector (MCP server + OAuth) ----------------------------------------
MCP_PUBLIC_URL=<https://mcp.example.org>
# MCP_OAUTH_AUTHORIZE_URL=<CMS_PUBLIC_URL>/oauth/authorize/
# MCP_OAUTH_REQUIRE_MFA=True
# MCP_CLAUDE_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
# MCP_OAUTH_DCR_ENABLED=False          # dynamic client registration; keep off
# MCP_OAUTH_MAX_GRANT_DAYS=30
# MCP_ACCESS_TOKEN_SECONDS=3600
# MCP_EXTRA_ALLOWED_HOSTS=
# CMS_SESSION_LIMIT=25                 # changes per Claude conversation
# MCP_RATE_LIMIT_PER_MINUTE=60
# MCP_WRITE_RATE_LIMIT_PER_MINUTE=20
# MCP_FETCH_ALLOWED_HOSTS=iitkgp.ac.in,*.iitkgp.ac.in   # hosts upload_image_from_url may fetch from
# MCP_FETCH_MAX_BYTES=10485760
# MCP_FETCH_TIMEOUT_SECONDS=10

# --- Cloudflare tunnel ------------------------------------------------------------
CLOUDFLARED_IMAGE=<cloudflare/cloudflared:VERSION@sha256:DIGEST>

# --- Set by docker-compose.yml for the backend services (do not set here) ----------
# DEBUG=False  CRTDH_ENV=production  TRUST_CF_CONNECTING_IP=True  REQUIRE_TRUSTED_PROXY=True
# TRUSTED_PROXY_IPS=<gateway and cloudflared fixed IPs>  STATIC_ROOT=/data/static  MEDIA_ROOT=/data/media
#
# --- Not for this file -------------------------------------------------------------
# Publish agent (campus PC): CRTDH_AGENT_CONFIG=<path to its config.ini>, CRTDH_AGENT_SECRET, CRTDH_CF_ACCESS_SECRET
# MCP evals (developer machine only): ANTHROPIC_API_KEY=<...>  MCP_EVAL_MODEL=<model id>
# Frontend dev/test scripts: BUILD_DIR, PORT, BASE_URL, CHROME_PATH, JS_BUDGET_KB, MEDIA_ROOT
# Admin build args (docker-compose.yml): VITE_API_BASE_URL, VITE_PUBLIC_SITE_URL; tests: VITE_USE_MOCK;
#   VITE_BASE (sub-path, e.g. /cms/ on academicweb)
# Only on hosts without this gateway (deploy/academicweb, set by its setup.sh; leave unset here):
#   ADMIN_DIST_DIR, TRUST_X_FORWARDED_FOR, USE_X_FORWARDED_HOST, FORWARDED_PROTO_DEFAULT, MEDIA_URL
# Tests and local development only, never in production: ALLOW_SQLITE, CRTDH_SKIP_DOTENV,
#   TEST_DATABASE_URL, CRTDH_ALLOW_SEED, CRTDH_ALLOW_TEST_SEED, CRTDH_TEST_PASSWORD,
#   CRTDH_TEST_SECRET, FAKE_BUILD_FAIL
